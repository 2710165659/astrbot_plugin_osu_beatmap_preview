{
  "max_image_queue_length": {
    "description": "图片渲染队列最大长度",
    "type": "int",
    "hint": "图片队列中包含正在等待和正在渲染的任务。队列已满时拒绝新的 /v、/vp、/vg 请求。",
    "default": 10
  },
  "max_video_queue_length": {
    "description": "视频渲染队列最大长度",
    "type": "int",
    "hint": "视频队列中包含正在等待和正在渲染的任务。队列已满时拒绝新的 /vv 请求。",
    "default": 3
  },
  "default_json": {
    "description": "核心默认配置（JSON）",
    "type": "text",
    "editor_mode": true,
    "editor_language": "json",
    "hint": "编辑 JSON 后下次请求立即生效。字段结构与上游 osu-beatmap-preview v1.3.2 的 --config 一致；v1.2.0 起配置拆分为 core/CLI 共享配置与 CLI 专用配置，本节 JSON 仍按同一份合并后的结构覆盖。",
    "default": "{\n  \"timeout\": {\n    \"PNG_TIMEOUT\": 60,\n    \"GIF_TIMEOUT\": 60,\n    \"MP4_TIMEOUT\": 120\n  },\n  \"render\": {\n    \"standard\": {\n      \"gif\": {\"style\": {\"FPS\": 30, \"DURATION_MS\": 5000}},\n      \"mp4\": {\"style\": {\"FPS\": 30}}\n    },\n    \"taiko\": {\n      \"png\": {\"style\": {\"SPACING_PER_BPM\": 0.0}},\n      \"gif\": {\"style\": {\"FPS\": 30, \"DURATION_MS\": 5000}},\n      \"mp4\": {\"style\": {\"FPS\": 30}}\n    },\n    \"catch\": {\n      \"gif\": {\"style\": {\"FPS\": 30, \"DURATION_MS\": 5000}},\n      \"mp4\": {\"style\": {\"FPS\": 30}}\n    },\n    \"mania\": {\n      \"gif\": {\"style\": {\"FPS\": 30, \"DURATION_MS\": 5000}},\n      \"mp4\": {\"style\": {\"FPS\": 30}}\n    }\n  }\n}"
  }
}
